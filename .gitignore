# =============================================================================
# Data — Selective ignore
# =============================================================================
# Dataset mentah & interim di-ignore (besar, dapat di-regenerate via pipeline)
data/raw/*
data/interim/*
data/external/*

# features.csv DI-COMMIT untuk konteks pasar di Streamlit Cloud
# predictions.csv di-ignore (hanya output demo)
data/processed/predictions.csv

# Pertahankan .gitkeep agar struktur folder tetap ada di repo
!data/**/.gitkeep

# =============================================================================
# Model Artifacts — JANGAN di-commit
# =============================================================================
# Model di-host di Hugging Face Hub, bukan di repository
models/*
!models/.gitkeep

